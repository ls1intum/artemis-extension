{
  "name": "iris-thaumantias",
  "displayName": "Artemis - TUM",
  "description": "Artemis brings interactive learning to life with instant, individual feedback on programming exercises, quizzes, modeling tasks, and more. This VS Code extension integrates Iris, an LLM-based virtual assistant that supports students with instant answers about exercises, lectures, and learning performance. Iris provides context-aware, personalized assistance for programming exercises, encouraging independent problem-solving through subtle hints and guiding questions instead of giving full solutions.",
  "version": "0.4.1",
  "publisher": "aet-tum",
  "license": "MIT",
  "icon": "media/artemis-blue.png",
  "preRelease": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/ls1intum/artemis-extension"
  },
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "ai",
    "tutor",
    "education",
    "artemis",
    "programming",
    "learning",
    "computer science",
    "tutoring"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "artemis.login",
        "title": "Login to Artemis",
        "icon": "$(sign-in)"
      },
      {
        "command": "artemis.logout",
        "title": "Logout from Artemis",
        "icon": "$(sign-out)"
      },
      {
        "command": "artemis.checkIrisHealth",
        "title": "Check Iris Health Status",
        "icon": "$(heart)"
      },
      {
        "command": "artemis.resetIrisChat",
        "title": "Reset Iris Chat Sessions (Debug)",
        "icon": "$(refresh)"
      },
      {
        "command": "artemis.checkWebSocketStatus",
        "title": "Check WebSocket Connection Status",
        "icon": "$(broadcast)"
      },
      {
        "command": "artemis.connectWebSocket",
        "title": "Connect to Artemis WebSocket",
        "icon": "$(plug)"
      },
      {
        "command": "artemis.showStruggleScore",
        "title": "Show Struggle Detection Score (Debug)",
        "icon": "$(graph)"
      },
      {
        "command": "artemis.replaySession",
        "title": "Replay Session (EQ Tuning)",
        "icon": "$(play)"
      },
      {
        "command": "artemis.clearTrustedDomains",
        "title": "Artemis: Clear Trusted Domains"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "artemis.login", "when": "!iris:managedEnvironment" },
        { "command": "artemis.logout", "when": "!iris:managedEnvironment" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "artemis-login",
          "title": "Artemis",
          "icon": "media/artemis-logo.png"
        },
        {
          "id": "iris-chat",
          "title": "Iris Chat",
          "icon": "media/iris-monochrome.png"
        }
      ]
    },
    "views": {
      "artemis-login": [
        {
          "type": "webview",
          "id": "artemis.loginView",
          "name": "Artemis",
          "icon": "media/artemis-logo.png",
          "when": "!iris:managedEnvironment || !iris:authenticated"
        }
      ],
      "iris-chat": [
        {
          "type": "webview",
          "id": "iris.chatView",
          "name": "Chat",
          "icon": "media/iris-monochrome.png",
          "when": "iris:authenticated == true"
        }
      ]
    },
    "configuration": {
      "title": "Artemis",
      "properties": {
        "artemis.serverUrl": {
          "type": "string",
          "default": "https://artemis.tum.de",
          "markdownDescription": "The URL of the Artemis server to connect to.\n\nFor a custom URL not listed here, [open settings.json](command:workbench.action.openSettingsJson) and edit `artemis.serverUrl` directly.",
          "enum": [
            "https://artemis.tum.de",
            "https://artemis-test1.artemis.cit.tum.de",
            "https://artemis-test2.artemis.cit.tum.de",
            "https://artemis-test3.artemis.cit.tum.de",
            "https://artemis-test4.artemis.cit.tum.de",
            "https://artemis-test5.artemis.cit.tum.de",
            "https://artemis-test6.artemis.cit.tum.de",
            "https://artemis-test9.artemis.cit.tum.de",
            "http://localhost:9000"
          ],
          "enumItemLabels": [
            "Production (artemis.tum.de)",
            "Test Server 1 (artemis-test1.artemis.cit.tum.de)",
            "Test Server 2 (artemis-test2.artemis.cit.tum.de)",
            "Test Server 3 (artemis-test3.artemis.cit.tum.de)",
            "Test Server 4 (artemis-test4.artemis.cit.tum.de)",
            "Test Server 5 (artemis-test5.artemis.cit.tum.de)",
            "Test Server 6 (artemis-test6.artemis.cit.tum.de)",
            "Test Server 9 (artemis-test9.artemis.cit.tum.de)",
            "Local Development (localhost:9000)"
          ]
        },
        "artemis.iris.sendUncommittedChanges": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Allow Iris to access your uncommitted file changes (unsaved, unstaged, and unpushed files). When enabled, Iris can see your current work-in-progress code to provide better assistance. **Privacy**: Only files from your current workspace are sent, and only when you send a message to Iris."
        },
        "artemis.developerMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable developer mode to show debugging tools, including debug buttons in views and live struggle detection score in the status bar."
        },
        "artemis.showWebSocketStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show the WebSocket connection status in the status bar during normal operation. When a connection failure occurs, the status bar item is always shown regardless of this setting."
        },
        "artemis.debugMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable debug mode to show additional developer tools like WebSocket status in the status bar. Useful for troubleshooting connection issues."
        },
        "artemis.defaultCommitMessage": {
          "type": "string",
          "default": "Solution submission via Iris extension",
          "description": "Default commit message used for automatic exercise submissions (shown when submitting without a custom message)"
        },
        "artemis.showUnsavedChangesWarning": {
          "type": "boolean",
          "default": true,
          "description": "Show a warning banner when there are unsaved changes in the workspace before submitting"
        },
        "artemis.defaultClonePath": {
          "type": "string",
          "default": "",
          "description": "Default folder where all exercise repositories will be cloned automatically. Leave empty to choose a location each time.",
          "markdownDescription": "**Default folder for exercise repositories**\n\nWhen set, all exercises will be automatically cloned to this folder without asking. Leave empty to choose manually each time.\n\nExample: `/Users/username/artemis-exercises` or `C:\\Users\\username\\artemis-exercises`"
        },
        "artemis.showSetDefaultClonePathPrompt": {
          "type": "boolean",
          "default": true,
          "description": "Ask to set a default clone folder when cloning for the first time (if no default is configured)"
        },
        "artemis.struggleDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable struggle detection to receive helpful hints when you might be stuck on a problem"
        },
        "artemis.startPage": {
          "type": "string",
          "enum": [
            "dashboard",
            "course-list",
            "workspace-course",
            "workspace-exercise"
          ],
          "enumDescriptions": [
            "Show the dashboard with recent courses and exercises (default)",
            "Show the full list of all your courses",
            "Show the course page for the exercise open in your workspace",
            "Show the details of the exercise open in your workspace"
          ],
          "default": "dashboard",
          "description": "Choose which page to show after logging in"
        },
        "artemis.showStartPageSuggestion": {
          "type": "boolean",
          "default": true,
          "description": "Suggest configuring the start page when an exercise is detected in the current workspace"
        },
        "artemis.dataCollectionConsent": {
          "type": "string",
          "enum": [
            "pending",
            "declined",
            "basic",
            "extended"
          ],
          "default": "pending",
          "enumDescriptions": [
            "No decision made yet",
            "Data collection declined",
            "Basic data collection (anonymized)",
            "Extended data collection (detailed recordings)"
          ],
          "markdownDescription": "Controls your consent level for data collection used to improve Iris. **Extended** enables detailed telemetry for research purposes. You can change this at any time."
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "dev": "node esbuild.js --watch",
    "package": "npm run check-types && npm run lint:src && node esbuild.js --production",
    "package:vsix": "npm run package && vsce package",
    "analyze": "esbuild-visualizer --metadata=dist/meta-webview.json --open",
    "analyze:text": "node -e \"const e=require('esbuild'),f=require('fs'); e.analyzeMetafile(JSON.parse(f.readFileSync('dist/meta-webview.json','utf8'))).then(console.log)\"",
    "analyze:ext": "esbuild-visualizer --metadata=dist/meta-extension.json --open",
    "build:analyze": "npm run package && npm run analyze",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:src": "eslint src",
    "test:unit": "vscode-test --label unit",
    "test:unit:coverage": "vscode-test --label unit --coverage",
    "test:react": "vitest run",
    "test:react:watch": "vitest",
    "test:react:coverage": "vitest run --coverage",
    "test:struggle": "npm run compile-tests && vscode-test --label struggle",
    "test:e2e": "npm run compile-tests && vscode-test --label e2e",
    "test:ui": "bash test/e2e/ui/run-tests.sh",
    "test:all": "npm run test:unit && npm run test:react",
    "coverage:all": "npm run test:unit:coverage && npm run test:react:coverage",
    "knip": "knip",
    "knip:exports": "knip --exports",
    "clean": "rm -rf dist out *.vsix",
    "compile:clean": "npm run clean && npm run compile",
    "prepare": "husky",
    "vscode:prepublish": "npm run package"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/dompurify": "3.2.0",
    "@types/katex": "0.16.8",
    "@types/marked": "5.0.2",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.9",
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@types/sinon": "21.0.0",
    "@types/vscode": "1.110.0",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.57.2",
    "@typescript-eslint/parser": "8.57.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.0.18",
    "@vscode/test-cli": "0.0.12",
    "@vscode/test-electron": "2.5.2",
    "axe-core": "4.11.1",
    "esbuild": "0.28.0",
    "esbuild-css-modules-plugin": "3.1.5",
    "esbuild-plugin-inline-worker": "0.1.1",
    "esbuild-visualizer": "0.7.0",
    "eslint": "9.39.4",
    "happy-dom": "20.8.9",
    "husky": "9.1.7",
    "knip": "5.88.1",
    "lint-staged": "16.4.0",
    "mocha-junit-reporter": "2.2.1",
    "npm-run-all2": "8.0.4",
    "sinon": "21.0.3",
    "typescript": "5.9.3",
    "typescript-plugin-css-modules": "5.2.0",
    "vitest": "4.0.18",
    "vscode-extension-tester": "8.22.0"
  },
  "dependencies": {
    "@stomp/stompjs": "7.3.0",
    "clsx": "2.1.1",
    "dompurify": "3.3.3",
    "katex": "0.16.44",
    "lucide-react": "0.575.0",
    "marked": "17.0.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-textarea-autosize": "8.5.9",
    "shiki": "3.23.0",
    "streamdown": "2.5.0",
    "use-stick-to-bottom": "1.1.3",
    "ws": "8.19.0",
    "zustand": "5.0.12"
  }
}
